# ══════════════════════════════════════════════════════════════════════
#  Jarvis — configuration
#  Edit values after the "=" sign. Then restart Jarvis (run START.bat).
# ══════════════════════════════════════════════════════════════════════

# ─── General ───
APP_NAME=Jarvis
LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════════════
#  AI BRAIN (LLM) — works FREE out of the box, no key required.
#
#  LLM_PROVIDER options:
#    auto          -> if you add a key below it auto-detects it,
#                     otherwise uses the FREE pollinations brain. (default)
#    pollinations  -> FREE, no key, no install. Always works with internet.
#    groq          -> FREE key from https://console.groq.com  (very fast)
#    gemini        -> FREE key from https://aistudio.google.com
#    openrouter    -> FREE key from https://openrouter.ai
#    openai        -> PAID key from https://platform.openai.com
#    ollama        -> 100% offline; needs Ollama installed locally, no key.
#
#  To use your own key: set LLM_PROVIDER (or leave auto) and paste the key.
#  The in-app "⚙️ AI Settings" box can also set this for you — no file editing.
# ══════════════════════════════════════════════════════════════════════
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SEC=60

# ─── Local Ollama (only used when LLM_PROVIDER=ollama) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ─── API server ───
API_HOST=127.0.0.1
API_PORT=8000

# ─── Regional defaults ───
TIMEZONE=Asia/Kolkata
DEFAULT_LOCATION=Ludhiana
NEWS_COUNTRY=IN

# ─── Feature flags ───
ENABLE_CALENDAR=True
AUTO_OPEN_BROWSER=True
